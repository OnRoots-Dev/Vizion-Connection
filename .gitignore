# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# personal local settings (Claude Code settings.local.json etc.)
*.local.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local lottie preview player
/tools/lottie-player/

# local Claude Code skills / tooling (not part of the app)
# — ただしプロジェクト専用スキル (db-migration, deploy) は Git 管理する
.claude/skills/*
!.claude/skills/db-migration/
!.claude/skills/deploy/
